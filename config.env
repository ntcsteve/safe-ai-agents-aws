# Where this runs. Edit a value, then run ./kopi up.

# Only ap-southeast-2 has been tested. Any region with AgentCore and a Claude model should work.
REGION=ap-southeast-2

# A Bedrock inference profile in that region. The au. profile keeps prompts in Australia.
MODEL=au.anthropic.claude-sonnet-4-6

# A file in scenario/, without .json.
SCENARIO=kopi
