# Copy to clumio.env (gitignored) and fill it in. This is the only Clumio file you edit.
# ./kopi reads these three keys and refuses any other, so this file can never change your AWS account.

# From the Clumio portal.
CLUMIO_API_TOKEN=

# Your Clumio region's API address, for example https://us-west-2.api.clumio.com
CLUMIO_API_BASE_URL=

# Optional: leave blank unless your tenant uses organizational units.
CLUMIO_OU_ID=
