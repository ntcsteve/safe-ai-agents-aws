#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.13"
# dependencies = ["boto3", "botocore[crt]"]
# ///
"""Kopi Kiosk. Every command prints one named state and the next step. See README.md.

./kopi           where you are, and what to run next
./kopi up        deploy, or apply a changed config or scenario
./kopi safe      prove nothing in the agent's path can write
./kopi break     apply the bad change
./kopi observe   the agent investigates, then its receipts
./kopi recover   preview, type ROLL BACK, restore the one bad menu. Add --clumio to use Clumio
./kopi check     HEALTHY or BROKEN (exit 0 or 1)
./kopi reset     good menus, the promo live
./kopi down      remove everything
./kopi clumio    optional: connect Clumio. See addons/clumio/README.md
./kopi eval      three scripted agent checks, for prompt or model changes
"""

import datetime
import functools
import hashlib
import json
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

from botocore.exceptions import BotoCoreError, ClientError  # noqa: E402

from kiosk import commands, config, menu, preflight, recovery, states  # noqa: E402
from kiosk.s3_store import MenuStore  # noqa: E402

INFRA = ROOT / "infra"


class NotDeployed(RuntimeError):
    pass


class Demo:
    """What every command gets: the config, the scenario, the deployed outputs, and the menu operations."""

    def __init__(self, settings, scenario, args=()):
        self.settings = settings
        self.scenario = scenario
        self.args = args

    @functools.cached_property
    def deployed(self):
        return read_deployed()

    @property
    def outputs(self):
        if self.deployed is None:
            raise NotDeployed(f"NOT DEPLOYED. Next: {states.NEXT[states.State.NOT_DEPLOYED]}")
        return self.deployed

    def forget_deployed(self):
        for cached in ("deployed", "store"):
            self.__dict__.pop(cached, None)

    def state(self):
        return states.read_state(self.deployed, self.settings, self.file_hashes(), self.is_healthy)

    def file_hashes(self):
        scenario = ROOT / "scenario" / f"{self.settings.scenario}.json"
        files = {"scenario_hash": scenario, "prompt_hash": INFRA / "investigator-prompt.md"}
        return {name: hashlib.sha256(path.read_bytes()).hexdigest() for name, path in files.items()}

    def is_healthy(self):
        return menu.check_menus(self.store.read_menus(self.scenario), self.scenario).state is menu.Health.HEALTHY

    def refusal_for(self, command, state):
        if state is states.State.REGION_CHANGED:
            detail = f"deployed in {self.deployed['region']}, config.env says {self.settings.region}"
        elif state is states.State.CONFIG_NOT_APPLIED:
            detail = ", ".join(states.differences(self.deployed, self.settings, self.file_hashes()))
        else:
            detail = ""
        return states.refusal(command, state, detail)

    @functools.cached_property
    def store(self):
        return MenuStore(self.outputs["bucket"], self.outputs["region"])

    def reset(self):
        promo = self.scenario["promo"]
        expected = menu.apply_promo(menu.seed_menus(self.scenario), self.scenario)
        version_ids = {key: self.store.write_menu(key, stall_menu) for key, stall_menu in expected.items()}
        promo_key = menu.menu_key(promo["stall"])
        self.store.write_log({"changes": [_log_entry(promo, promo_key, version_ids[promo_key])]})
        print(f"RESET: every menu is good, with {promo['change_id']} live.")
        return self.check()

    def fault(self):
        fault = self.scenario["fault"]
        changed = menu.apply_fault(self.store.read_menus(self.scenario), self.scenario)  # refuses before writing
        key = menu.menu_key(fault["stall"])
        version_id = self.store.write_menu(key, changed[key])
        log = self.store.read_log()
        log["changes"].append(_log_entry(fault, key, version_id))
        self.store.write_log(log)
        print(f"APPLIED: {fault['change_id']} {fault['title']} -> {key} (version {version_id})")
        return self.check()

    def restore(self, key, version):
        self.log_restore(key, self.store.write_menu(key, version["menu"]), version["version_id"])

    def log_restore(self, key, version_id, source):
        fault = self.scenario["fault"]
        log = self.store.read_log()
        change = {"change_id": recovery.restore_id(fault["change_id"]), "title": f"Restored from {source}"}
        log["changes"].append(_log_entry(change, key, version_id))
        self.store.write_log(log)

    def check(self):
        result = menu.check_menus(self.store.read_menus(self.scenario), self.scenario)
        # While the fault is in the log (until the next reset), say how long it has been.
        log, change_id = self.store.read_log(), self.scenario["fault"]["change_id"]
        now = datetime.datetime.now(datetime.UTC).isoformat(timespec="seconds")
        clock = recovery.recovery_clock(log, change_id, now, self.scenario["impact_tolerance_minutes"])
        print(f"{result.state}, {clock}" if clock else result.state)
        for problem in result.problems:
            print(f"  {problem}")
        return 0 if result.state is menu.Health.HEALTHY else 1


def cmd_up(demo):
    print(f"Target: {preflight.check(demo.settings)}", flush=True)  # before Terraform writes to the same stream
    _terraform("init", "-input=false", "-lockfile=readonly")  # the tested providers, never newer ones
    _terraform("apply", *demo.settings.terraform_vars())  # shows the plan and asks before it creates anything
    demo.forget_deployed()
    demo.reset()  # always: one rule, so a crash before this line is fixed by running up again
    print(f"UP: {demo.outputs['url']}\nNext: ./kopi safe. When finished: ./kopi down, because this costs money")


def cmd_down():
    """Runs before the state table, so a config typo, a failed scenario check or a missing bucket cannot stand
    between someone and stopping the bill. One thing still can: Terraform reads the scenario file itself, so that
    file must be valid JSON. It uses what is deployed, because after an edit config.env would miss the stack.
    With no outputs it still destroys from config.env: a partial apply can leave resources behind."""
    live = read_deployed()
    settings = config.Config(live["region"], live["model"], live["scenario"]) if live else _load_config()
    addon = clumio_addon()
    if addon and addon.is_active():  # first: deleting a protected bucket would orphan its protection
        addon.disconnect()
    _terraform("destroy", *settings.terraform_vars())
    removed = commands.delete_agent_logs(settings.region)
    print(f"DOWN: everything is deleted, including {removed} agent log group(s) Terraform did not create.")


def cmd_status(demo):
    state = demo.state()
    if state in states.RUNNING:
        print("State: ", end="")
        demo.check()
    else:
        print(f"State: {state}")
    next_step = states.NEXT[state]
    if demo.deployed:
        print(f"Page:  {demo.deployed['url']}")
        addon = clumio_addon()
        clumio_status = addon.status(demo.deployed["bucket"]) if addon else None
        if clumio_status:
            print(clumio_status[0])
            if state is states.State.HEALTHY:  # a broken menu always gets its recovery steps
                next_step = clumio_status[1] or next_step
    print(f"Next:  {next_step}")


def cmd_clumio(demo):
    return _require_clumio().connect(demo)


def cmd_recover(demo):
    return _require_clumio().recover(demo) if "--clumio" in demo.args else commands.cmd_recover(demo)


COMMANDS = {
    "status": cmd_status,
    "up": cmd_up,
    "clumio": cmd_clumio,
    "safe": commands.cmd_safe,
    "break": commands.cmd_break,
    "observe": commands.cmd_observe,
    "recover": cmd_recover,
    "check": lambda demo: demo.check(),
    "reset": lambda demo: demo.reset(),
    "eval": commands.cmd_eval,
}


def _log_entry(change, key, version_id):
    return {
        "change_id": change["change_id"],
        "title": change["title"],
        "key": key,
        "version_id": version_id,
        "applied_at": datetime.datetime.now(datetime.UTC).isoformat(timespec="seconds"),
        "approved_by": "the operator",
    }


def clumio_addon():
    """The add-on, or None if its folder is gone: the AWS demo never depends on it."""
    try:
        from addons.clumio import backtrack
    except ModuleNotFoundError:
        return None
    return backtrack


def _require_clumio():
    addon = clumio_addon()
    if addon is None:
        raise recovery.RecoveryRefused(
            "CLUMIO NOT SET UP: addons/clumio is missing. Next: ./kopi recover uses S3 versions"
        )
    return addon


def read_deployed():
    """Terraform's outputs, or None when nothing is deployed."""
    try:
        result = subprocess.run(["terraform", f"-chdir={INFRA}", "output", "-json"], capture_output=True, text=True)
    except FileNotFoundError:  # no Terraform yet: ./kopi up's preflight names the fix
        return None
    outputs = json.loads(result.stdout or "{}") if result.returncode == 0 else {}
    return {name: value["value"] for name, value in outputs.items()} if "bucket" in outputs else None


def _load_config():
    path = ROOT / "config.env"
    if not path.exists():
        raise config.ConfigInvalid("config.env is missing")
    return config.parse_config(path.read_text(), {file.stem for file in (ROOT / "scenario").glob("*.json")})


def _load_scenario(name):
    path = ROOT / "scenario" / f"{name}.json"
    try:
        return menu.load_scenario(json.loads(path.read_text()))
    except (menu.ScenarioError, json.JSONDecodeError) as error:
        raise menu.ScenarioError(f"{error}. Next: fix scenario/{name}.json") from error


def _terraform(*args):
    subprocess.run(["terraform", f"-chdir={INFRA}", *args], check=True)


def main(argv):
    name = argv[1] if len(argv) > 1 else "status"
    if name != "down" and name not in COMMANDS:
        print(__doc__)
        return 2
    try:
        if name == "down":
            return cmd_down() or 0
        settings = _load_config()
        demo = Demo(settings, _load_scenario(settings.scenario), argv[2:])
        state = demo.state()
        if state not in states.ALLOWED[name]:
            print(demo.refusal_for(name, state))
            return 2
        return COMMANDS[name](demo) or 0
    except config.ConfigInvalid as error:
        print(f"CONFIG INVALID: {error}. Next: fix config.env")
    except menu.ScenarioError as error:
        print(f"SCENARIO INVALID: {error}")
    except menu.ChangeRefused as error:
        print(f"REFUSED: {error}")
    except recovery.RecoveryRefused as error:
        print(error)
    except preflight.PreflightFailed as error:
        print(f"PREFLIGHT FAILED: {error}")
    except (NotDeployed, commands.AgentUnavailable) as error:
        print(error)
    except subprocess.CalledProcessError as error:
        print(f"TERRAFORM FAILED: exit {error.returncode}. Next: read the output above")
    except (ClientError, BotoCoreError) as error:
        print(f"AWS FAILED: {error}. Next: check your AWS credentials")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
