#!/usr/bin/env bash
# Is everything green? Style, tests, and Terraform format and validity. Changes nothing in AWS.
# One command per line: `set -e` ignores a failure on the left of `&&`, which once printed GREEN after a failure.
set -euo pipefail
cd "$(dirname "$0")"
echo "== Python style"
uvx -q ruff check .
uvx -q ruff format --check . | tail -1
echo "== Python tests"
uv run -q --python 3.13 --with boto3 python -m unittest discover -s tests -t . 2>&1 | tail -1
if [ -d addons/clumio ]; then
  uv run -q --python 3.13 --with boto3 python -m unittest addons.clumio.test_clumio 2>&1 | tail -1
fi
echo "== JS tests"
node --test tests/*.test.mjs 2>&1 | grep -E '^ℹ (pass|fail)'
echo "== Terraform"
for root in infra addons/clumio; do
  [ -d "$root" ] || continue  # the add-on is optional
  terraform fmt -check -recursive "$root"
  terraform -chdir="$root" init -backend=false -input=false -lockfile=readonly >/dev/null
  terraform -chdir="$root" validate -no-color | head -1
done
echo "GREEN"
